# Fig.Feed no Hostinger (figfeed.jvpereira.cc)
# Só o app fica público: banco, funções, histórico do git e anotações ficam escondidos.
Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RedirectMatch 404 "/\.(git|github|gitignore)"
RedirectMatch 404 "/(supabase/|prototipo-|README\.md|VERSOES\.md|fig-feed\.zip)"
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
